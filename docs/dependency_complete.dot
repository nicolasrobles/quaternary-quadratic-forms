"aux:singint_absolute" [label=<<B>aux:singint_absolute</B><BR/>Absolute convergence of<BR/>sigma_infty for arbitrary<BR/>compactly supported smooth weight,<BR/>including the cone vertex<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L756-L761"];
"aux:conecount" [label=<<B>aux:conecount</B><BR/>Dual-cone inverse-norm weighted<BR/>lattice count O(U^(1+epsilon))<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L814-L824"];
"aux:polynomialbox_epsilon" [label=<<B>aux:polynomialbox_epsilon</B><BR/>Replace C_(n,E)^omega(m) by<BR/>O_(n,E,epsilon)(m^epsilon)<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L900-L901"];
"aux:ramanujan" [label=<<B>aux:ramanujan</B><BR/>Ramanujan-sum exponential and<BR/>divisor definitions agree;<BR/>prime-power values and<BR/>multiplicativity are<BR/>derived/verified library facts<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1042-L1046"];
"aux:Cfactor" [label=<<B>aux:Cfactor</B><BR/>C_q(u)=product_(p|q) C_p(u) and<BR/>multiplicativity of S_c(u)<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1089-L1090"];
"aux:quadratic_gauss_1d" [label=<<B>aux:quadratic_gauss_1d</B><BR/>Scalar quadratic Gauss identity<BR/>and tau_p^2=chi_p(-1)p, extracted<BR/>from proof of Lemma3.2<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1127-L1137"];
"aux:Sxi" [label=<<B>aux:Sxi</B><BR/>Identity between global-series and<BR/>local-product definitions of the<BR/>main coefficient S_xi(q)<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1515-L1521"];
"aux:Sxibound" [label=<<B>aux:Sxibound</B><BR/>Uniform main-coefficient bound<BR/>|S_xi(q)| &lt;= |S_F|(4K)^omega(q)/q<BR/>&lt;&lt; q^(-1+epsilon)<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1522-L1527"];
"aux:fourier_instantiation" [label=<<B>aux:fourier_instantiation</B><BR/>Geometric weights satisfy Section3<BR/>framework with N=N_G, E=E_(F,n),<BR/>K=2n^2<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1850-L1853"];
"aux:diagonal_strata" [label=<<B>aux:diagonal_strata</B><BR/>Diagonal weights satisfy two-level<BR/>bound (3.3) with K=8 and<BR/>D_p(u)=F*(u)u1u2u3u4<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1979-L1983"];
"aux:Ipiece" [label=<<B>aux:Ipiece</B><BR/>Localized scaled integral bound<BR/>and differentiability used in the<BR/>three frequency estimates<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2091-L2124"];
"supp:matrix_representation" [label=<<B>supp:matrix_representation</B><BR/>Any integral quadratic polynomial<BR/>becomes x^T A x with integral<BR/>symmetric A after multiplying by2,<BR/>without changing its zeros<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L158-L165"];
"supp:smooth_equivalence" [label=<<B>supp:smooth_equivalence</B><BR/>Rank-two condition is equivalent<BR/>to the smooth<BR/>complete-intersection curve<BR/>formulation<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L279-L293"];
"supp:projective_values" [label=<<B>supp:projective_values</B><BR/>Projective well-definedness and<BR/>local-cover point interpretation<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L307-L318"];
"supp:local_mean_factor" [label=<<B>supp:local_mean_factor</B><BR/>The Euler factor equals (1-p^(-2))<BR/>times the projective character<BR/>mean<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L347-L352"];
"supp:nontrivial_range" [label=<<B>supp:nontrivial_range</B><BR/>Power-saving range for<BR/>quadratic-character sums relative<BR/>to B^2<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L350-L353"];
"supp:polynomial_height" [label=<<B>supp:polynomial_height</B><BR/>Polynomial coefficient heights<BR/>recover the B^(5/3+epsilon) count<BR/>uniformly<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L372-L374"];
"supp:diagonal_signs" [label=<<B>supp:diagonal_signs</B><BR/>Product identity for kappa_i and<BR/>possible quadratic trace signs<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L402-L404"];
"supp:even_power_reduction" [label=<<B>supp:even_power_reduction</B><BR/>Even power counts follow from the<BR/>square-value theorem<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L455-L457"];
"supp:im_bound_recovered" [label=<<B>supp:im_bound_recovered</B><BR/>Recover the valid Iwaniec-Munshi<BR/>character-sum bound in the<BR/>good-modulus range<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L234-L238"];
"supp:mallesham_counterexample" [label=<<B>supp:mallesham_counterexample</B><BR/>Diagonal sums have exact order<BR/>B^2/q, contradicting the smaller<BR/>proposed leading term in M<BR/>Proposition2.1<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L238-L244"];
"supp:hss_comparison" [label=<<B>supp:hss_comparison</B><BR/>Summing HSS individual<BR/>residue-class error bounds loses a<BR/>power of q<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L254-L259"];
"supp:remark41_zero" [label=<<B>supp:remark41_zero</B><BR/>Zero frequency gives genuinely<BR/>p^2-sized C_p(0) in diagonal<BR/>examples<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1985-L1989"];
"supp:remark41_offcone" [label=<<B>supp:remark41_offcone</B><BR/>Explicit off-dual-cone example<BR/>with C_p(u)&gt;=p(p-5)<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1989-L2001"];
"supp:remark41_im" [label=<<B>supp:remark41_im</B><BR/>Convert the off-cone example into<BR/>the IM complete-sum counterexample<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2001-L2011"];
"supp:remark41_ramified" [label=<<B>supp:remark41_ramified</B><BR/>Explicit nonzero dual-cone example<BR/>with ramified sum chi_p(2)p^4(p-1)<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2011-L2015"];
"supp:relative_ranges" [label=<<B>supp:relative_ranges</B><BR/>Uniform relative-error convergence<BR/>in all three modulus ranges<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2780-L2786"];
"supp:determinant_thresholds" [label=<<B>supp:determinant_thresholds</B><BR/>Compare determinant-method and<BR/>logarithmic-height sieve bounds<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2862-L2878"];
"supp:frequency_error_summary" [label=<<B>supp:frequency_error_summary</B><BR/>Identify which frequency<BR/>contribution produces each error<BR/>scale<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2889-L2901"];
"supp:conditional_sieve" [label=<<B>supp:conditional_sieve</B><BR/>Conditional improvement of the<BR/>exponent with the height term<BR/>retained<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2903-L2919"];
"supp:abstract_weight_specialization" [label=<<B>supp:abstract_weight_specialization</B><BR/>Apply the abstract analytic<BR/>proposition to other local<BR/>functions satisfying its stated<BR/>hypotheses<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2933-L2939"];
"supp:square_determinant" [label=<<B>supp:square_determinant</B><BR/>Square-determinant untwisted count<BR/>has B^2 log B and B^2 terms with<BR/>the stated error<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L2944-L2947"];
