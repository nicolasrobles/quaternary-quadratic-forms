digraph NumberedResults {
graph [rankdir=TB, newrank=true, compound=true, outputorder=edgesfirst,
  bgcolor="white", fontname="DejaVu Serif", fontsize=23, labelloc=t,
  label="Dependency graph for the numbered results\nFrozen github manuscript | 22 certified; 20 pending\nLiterature inputs trusted; 4 Lean premises registered",
  nodesep=0.30, ranksep=0.58, pad=0.28, splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#fff4dc", color="#b88023",
  fontname="DejaVu Serif", fontsize=12, penwidth=1.15, margin="0.12,0.09"];
edge [color="#4b5563", arrowsize=0.70, penwidth=1.05];
subgraph cluster_sources { label="Trusted reference inputs (assumed, not reproved)"; fontsize=15; color="#a59adc"; style="rounded"; rank=same;
"source:EXT.PROJECTIVE_JACOBIAN" [label="EXT.PROJECTIVE_JACOBIAN\nMapped sources; no registered Lean premise", fillcolor="#eeeafd", color="#7762b4", fontsize=11];
"source:FINITE" [label="Weil, Katz and Fulton\nFinite-field sums and surface geometry\nRegistered Lean: Weil; composite Katz", fillcolor="#eeeafd", color="#7762b4", fontsize=11];
"source:GEOMETRY" [label="Lang and Hartshorne\nElimination, Bertini, cyclotomic fields\nRegistered Lean: Lang elimination; composite Bertini", fillcolor="#eeeafd", color="#7762b4", fontsize=11];
"source:HB" [label="Heath-Brown\nDelta symbol, integrals, Poisson\nMapped sources; no registered Lean premise", fillcolor="#eeeafd", color="#7762b4", fontsize=11];
"source:MV" [label="Montgomery-Vaughan\nGauss, Ramanujan, L-series, primes\nMapped sources; no registered Lean premise", fillcolor="#eeeafd", color="#7762b4", fontsize=11];
"source:S" [label="Salberger\nComplete intersections and lines\nMapped sources; no registered Lean premise", fillcolor="#eeeafd", color="#7762b4", fontsize=11];
}
"thm:polynomial" [label=<<B>Theorem 1.1</B><BR/>Quadratic-character<BR/>asymptotic<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L320-L345", target="_blank", tooltip="Coefficient-uniform quadratic-character asymptotic; bad-prime height bound and local-factor bounds"];
"thm:uniformcount" [label=<<B>Theorem 1.2</B><BR/>Uniform square-value count<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L363-L370", target="_blank", tooltip="Uniform bound for nonzero square values on the integral quadric"];
"thm:diagonal" [label=<<B>Theorem 1.3</B><BR/>Explicit diagonal local<BR/>factors<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L388-L400", target="_blank", tooltip="Exact bad-prime product and diagonal local traces/factors"];
"thm:cyclic" [label=<<B>Theorem 1.4</B><BR/>Higher-order characters<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L420-L439", target="_blank", tooltip="Coefficient-uniform asymptotic for products of local characters of exact order r"];
"cor:powercount" [label=<<B>Corollary 1.1</B><BR/>Uniform power-value count<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L441-L453", target="_blank", tooltip="Uniform count of nonzero r-th powers, r>=3"];
"lem:delta" [label=<<B>Lemma 2.1</B><BR/>Delta identity and support<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L615-L626", target="_blank", tooltip="Heath-Brown delta identity, normalization and support, for Q >= 3"];
"lem:integrals" [label=<<B>Lemma 2.2</B><BR/>Localized integral<BR/>estimates<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L667-L688", target="_blank", tooltip="Uniform localization and delta-integral estimates, including r derivative bounds"];
"lem:quadriccount" [label=<<B>Lemma 2.3</B><BR/>Integer zeros of a quadric<BR/><FONT POINT-SIZE="10" COLOR="#b88023">[Pending]</FONT>>, fillcolor="#fff4dc", color="#b88023", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L769-L776", target="_blank", tooltip="O(U^(2+epsilon)) integral zeros of a nonsingular quaternary form with nonsquare rational determinant"];
"lem:polynomialbox" [label=<<B>Lemma 2.4</B><BR/>Polynomial congruences in<BR/>boxes<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L832-L843", target="_blank", tooltip="Coefficient-uniform simultaneous polynomial-congruence count for squarefree moduli, exact constant C_(n,E)"];
"lem:weil" [label=<<B>Lemma 2.5</B><BR/>Weil character-sum bound<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L908-L915", target="_blank", tooltip="Weil bound (m-1) sqrt(p) for a nonprincipal character and a degree-m polynomial with simple geometric roots"];
"cor:weilline" [label=<<B>Corollary 2.6</B><BR/>Projective-line bound<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L926-L933", target="_blank", tooltip="Projective-line character-sum bound (n-1) sqrt(p)+1"];
"lem:katz" [label=<<B>Lemma 2.7</B><BR/>Katz bound on the quadric<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L951-L964", target="_blank", tooltip="Quadric character-sum bound (2n^2-4n+4)p under smooth branch divisor"];
"lem:crt" [label=<<B>Lemma 3.1</B><BR/>CRT and scalar invariance<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1048-L1056", target="_blank", tooltip="CRT multiplicativity of complete sums and invariance under unit scaling of frequency"];
"lem:gauss" [label=<<B>Lemma 3.2</B><BR/>Gauss sums and point count<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1092-L1108", target="_blank", tooltip="Prime-power quadratic Gauss evaluation, unramified complete sum, and projective quadric point count"];
"lem:badprime" [label=<<B>Lemma 3.3</B><BR/>Bound at bad primes<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1156-L1161", target="_blank", tooltip="Uniform bound |S_c(u)| <= 4 sqrt(|alpha|) c^3, including bad primes"];
