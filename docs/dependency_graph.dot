"lem:average" [label=<<B>Lemma 3.11</B><BR/>Average over exceptional<BR/>frequencies<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1569-L1576", target="_blank", tooltip="Average Fourier bound over exceptional frequencies with divisibility by q1"];
