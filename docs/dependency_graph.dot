legend [shape=plain, style="", label="Solid: numbered prerequisite. Gray dashed: through an unnumbered proof step.\nPurple dashed: trusted source. Transitive numbered edges are omitted.\n22 certified; 20 pending. Partial means identified clauses checked; the full result is unfinished.\nClick a result for its manuscript statement. Full details are in the dependency inventory.", fontsize=11];
{rank=sink; legend;}
"cor:centered" -> legend [style=invis];
"cor:powercount" -> legend [style=invis];
"cor:relative" -> legend [style=invis];
"prop:salberger" -> legend [style=invis];
"thm:cyclic" -> legend [style=invis];
