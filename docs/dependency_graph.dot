"lem:goodglobal" [label=<<B>Lemma 3.5</B><BR/>Global formula and cone<BR/>ratio<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1240-L1252", target="_blank", tooltip="Global good-modulus formula and dual-cone ratio, including bad-prime factors in c"];
"lem:genericmod" [label=<<B>Lemma 3.6</B><BR/>Off-cone modulus sum<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1292-L1300", target="_blank", tooltip="Off-dual-cone absolute sum over c, retaining q1 | F*(u)"];
