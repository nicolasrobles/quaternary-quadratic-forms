"lem:diagbad" [label=<<B>Lemma 4.5</B><BR/>Diagonal bad-prime<BR/>criterion<BR/><FONT POINT-SIZE="10" COLOR="#408342">[Certified]</FONT>>, fillcolor="#e1f5df", color="#408342", URL="https://github.com/nicolasrobles/quaternary-quadratic-forms/blob/main/manuscript/quadratic_character_sums_github.tex#L1862-L1866", target="_blank", tooltip="Exact bad-prime criterion for diagonal quadratic G and N_G=rad(2 alpha M)"];
